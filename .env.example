# SharingLinkSpector LLM 配置（复制为 .env 使用）
# provider 选择: dmxapi | ollama | none（仅静态）
SLSPECTOR_PROVIDER=dmxapi

# --- dmxapi (OpenAI 兼容) ---
DMXAPI_BASE_URL=https://www.dmxapi.cn/v1
DMXAPI_API_KEY=sk-xxx
DMXAPI_MODEL=glm-5.2

# --- ollama (私有部署, OpenAI 兼容 /v1) ---
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
OLLAMA_API_KEY=ollama
OLLAMA_MODEL=qwen3:32b

# --- 通用 ---
# LLM 并发数（批量扫描时调低避免限流）
SLSPECTOR_LLM_CONCURRENCY=4
# 单条记录 LLM 超时（秒）
SLSPECTOR_LLM_TIMEOUT=120
# 外网代理（容器内访问 dmxapi 需要走宿主机 Clash）
# HTTPS_PROXY=http://host.docker.internal:7890
